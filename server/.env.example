# Azure SQL Server (Prisma SQL Server connector)
# Ejemplo de cadena de conexión para Azure SQL:
DATABASE_URL="sqlserver://TU-SERVIDOR.database.windows.net:1433;database=tayta_sabroso;user=TU-USUARIO@TU-SERVIDOR;password=TU_PASSWORD;encrypt=true;TrustServerCertificate=false"

# Ejemplo local (SQL Server Developer):
# DATABASE_URL="sqlserver://localhost:1433;database=tayta_sabroso;user=sa;password=TU_PASSWORD;encrypt=true;TrustServerCertificate=true"

JWT_SECRET="CAMBIAR_ESTA_CLAVE"
# Producción: NODE_ENV=production, JWT_SECRET propio de al menos 32 caracteres.
# Orígenes exactos de la interfaz, sin barra final ni comodines.
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"
NODE_ENV="development"
PORT=4000
