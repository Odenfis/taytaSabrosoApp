// Prisma model: User
Table usuarios {
  id nvarchar(36) [pk]
  empresa_id nvarchar(36) [ref: >? empresas.id]
  nombre nvarchar(120) [not null]
  hash_pin nvarchar(200) [not null]
  hash_contrasena nvarchar(200)
  rol nvarchar(20) [not null, default: 'Cajero']
  terminal nvarchar(100) [not null]
  url_avatar nvarchar(1000)
  empresa_asignada_id nvarchar(36)
  esta_activo boolean [not null, default: true]
  esta_eliminado boolean [not null, default: false]
  version int [not null, default: 1]
  creado_en datetime [not null, default: `now()`]
  actualizado_en datetime [not null]

  indexes {
    (empresa_id) [name: 'ix_usuarios_empresa_id']
  }
}

// Prisma model: Session
Table sesiones {
  id nvarchar(36) [pk]
  usuario_id nvarchar(36) [not null, ref: > usuarios.id] // delete: cascade
  dispositivo_id nvarchar(36) [not null, ref: > dispositivos.id]
  hash_token nvarchar(200) [unique, not null]
  expira_en datetime [not null]
  creado_en datetime [not null, default: `now()`]

  indexes {
    (usuario_id) [name: 'ix_sesiones_usuario_id']
    (dispositivo_id) [name: 'ix_sesiones_dispositivo_id']
  }
}

// Prisma model: Device
Table dispositivos {
  id nvarchar(36) [pk]
  empresa_id nvarchar(36) [ref: >? empresas.id]
  nombre nvarchar(100) [not null]
  codigo_terminal nvarchar(30) [unique, not null]
  ultima_vista_en datetime [not null, default: `now()`]
  esta_activo boolean [not null, default: true]

  indexes {
    (empresa_id) [name: 'ix_dispositivos_empresa_id']
  }
}
